# Copy to .env (gitignored) and fill in.
TAVILY_API_KEY=tvly-xxxxxxxx
SHEET_ID=
# Path to the Google service account key. Default is Harshit's AIOS key.
# GCP_KEY=C:\path\to\key.json
# fake until Yellow Slate's API exists, then api
CMS_MODE=api
# off = publish by hand from blog.docx. api = push unpublished drafts to their CMS.
BLOG_MODE=api
# Model for the write stage (e.g. sonnet, opus). Empty = Claude Code default.
# sonnet: the writer only structures facts it was handed, against a fixed template, and qc.py
# checks the structure deterministically. The research is the judgment-heavy, unchecked half,
# and that runs on opus via .claude/agents/school-researcher.md.
WRITE_MODEL=sonnet

# Yellow Slate pipeline API (handed over Oct 10, 2026). One base URL and one key for
# /health, /schools/search, /schools, /media, /blogs. Ask their tech team for the key.
YS_API_BASE=https://cmsadmin.yellowslate.com/api/pipeline
YS_API_KEY=
